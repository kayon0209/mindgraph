# ============================================================
# MindGraph — 企业制度与决策依据知识服务环境配置模板
# 复制为 .env 并修改: cp .env.example .env
# ⚠️ .env 包含密钥，禁止提交到 Git
# ============================================================

# ── 运行环境 ──
ENVIRONMENT=development       # development | staging | production
DEBUG=false
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console            # console | json (生产用 json)

# ── 服务配置 ──
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000/api/v1
# STREAMLIT_ORIGIN 仅供兼容归档版界面，新 Web 客户端使用 CORS_ORIGINS。
STREAMLIT_ORIGIN=http://localhost:8501
CORS_ORIGINS=http://localhost:5173,app://obsidian.md    # 多个用逗号分隔

# ── 认证模式 ──
# off: 关闭认证
# api_key: 使用 X-API-Key Header 鉴权
# bearer: 使用 Authorization: Bearer OIDC JWT；API Key fallback 必须走 X-API-Key
# demo: 演示模式（简单本地会话）
AUTH_MODE=demo
SESSION_TIMEOUT_SECONDS=3600
# AUTH_MODE=off 时的写权限开关：off 默认只读（匿名仅 read），
# 需要写/admin（重建索引、连接器、bad-case 导出等）时才设 true。
# 仅限本机单人开发；对外可达的部署请使用 api_key / bearer 模式。
AUTH_OFF_ALLOW_WRITES=false

# ── SSO / OIDC（Phase 5-4） ──
# 启用后，Authorization: Bearer <JWT> 走 OIDC 校验；无效 JWT 直接返回 401，
# 不会降级成匿名或把同一个 Bearer 值当作 API Key。
OIDC_ENABLED=false
OIDC_ISSUER_URL=                              # 如 https://login.microsoftonline.com/{tenant}/v2.0
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=                                # 可选；为空时回退到 OIDC_CLIENT_ID
OIDC_ALGORITHMS=RS256                         # 逗号分隔，如 RS256,HS256
OIDC_JWKS_CACHE_TTL_SECONDS=600
# 以下 claim 名称对应 IdP 返回的 JWT 字段，按需调整
OIDC_ROLES_CLAIM=roles
OIDC_WORKSPACES_CLAIM=workspaces
OIDC_DEPARTMENTS_CLAIM=departments
OIDC_USERNAME_CLAIM=preferred_username

# ── 本地目录连接器 ──
# 允许目录同步访问的 canonical 根目录，多个用逗号分隔。
# 项目 knowledge/ 始终作为受控根目录；目录同步接口要求 admin 角色。
# 未完成 source ownership 迁移前，连接器不会删除数据库中缺失的源文件记录。
CONNECTOR_ALLOWED_ROOTS=

# ── 安全 ──
RATE_LIMIT_ENABLED=false
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
MAX_UPLOAD_BYTES=10485760        # 10MB
PRIVACY_LOG_QUESTIONS=true

# ── LLM Provider — 智谱 AI ──
# 申请地址: https://open.bigmodel.cn/
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4.7
ZHIPU_VERIFIED=false

# ── LLM Provider — DeepSeek (OpenAI Compatible) ──
# 申请地址: https://platform.deepseek.com/
CHAT_PROVIDER=deepseek           # zhipu | deepseek | anthropic
OPENAI_COMPAT_PROVIDER_NAME=deepseek
OPENAI_COMPAT_BASE_URL=https://api.deepseek.com
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=deepseek-v4-flash
OPENAI_COMPAT_MODELS=deepseek-v4-flash    # 逗号分隔允许列表
OPENAI_COMPAT_VERIFIED=false
CHAT_TIMEOUT_SECONDS=60
CHAT_MAX_RETRIES=1

# ── LLM Provider — Anthropic (Claude) ──
# 申请地址: https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── Embedding 模型 ──
BGE_MODEL_NAME=BAAI/bge-small-zh-v1.5
# BGE_MODEL_REVISION=
BGE_BATCH_SIZE=32
BGE_LOCAL_FILES_ONLY=true

# ── 检索参数 ──
RETRIEVAL_CANDIDATE_COUNT=20
RETRIEVAL_FINAL_TOP_K=5
BM25_K1=1.5
BM25_B=0.75
RRF_CONSTANT=60
RERANKER_ENABLED=false
RERANKER_MODEL_NAME=BAAI/bge-reranker-base
RERANKER_LOCAL_FILES_ONLY=true
RERANK_TOP_N=10

# ── 图谱路由与概念挖掘开关 ──
# GRAPH_DEFAULT_ENABLED：true=自适应路由默认允许图扩展（需先过消融闸门，见 ADR-002）
# false=图保持实验态、仅客户端 opt-in
GRAPH_DEFAULT_ENABLED=false
# 问题概念挖掘（阶段B，仅数据积累）：聊天落库后自动增量挖掘，产出 proposed 候选
CONCEPT_MINE_AUTO_ENABLED=true
CONCEPT_MINE_AUTO_MIN_NEW_QUESTIONS=20
CONCEPT_MINE_GAP_MIN_SEEN=2

# ── Assist（M0/M1 受治理的 agent 交付面，默认关闭） ──
# true=挂载 /api/v1/assist（REST+SSE），进程内复用 ChatService（见 ADR-003）
ASSIST_ENABLED=false
# true=额外把 Assist 暴露为只读 MCP 工具 mindgraph_assist
ASSIST_MCP_ENABLED=false
ASSIST_TIMEOUT_SECONDS=60
ASSIST_MAX_TOP_K=10

# ── Agentic Evidence Layer 阶段开关（默认关闭；M0 仅登记，后续里程碑消费） ──
# M2：内置确定性 Assist；M3：服务端会话；M4：后台任务；M5：受控写工具
AGENT_ASSIST_ENABLED=false
AGENT_TASKS_ENABLED=false
AGENT_WRITE_TOOLS_ENABLED=false
CONVERSATION_PERSISTENCE_ENABLED=false
AGENT_MAX_TOOL_CALLS=3
AGENT_REQUEST_DEADLINE_SECONDS=45

# ── M5-A：mindgraph_save_artifact 写工具（低风险 private 保存） ──
# true = MCP tools/list 暴露 mindgraph_save_artifact（tools/list 过滤 +
# handler fail-closed 双门控）。回滚：置回 false 即隐藏工具，已保存存档
# 保留在 saved_artifacts 表但停止新写入（不破坏性降级）。
# ── M5-A 工具 B：submit_evidence_feedback（中风险，独立开关） ──
# AGENT_FEEDBACK_TOOL_ENABLED=true：暴露 mindgraph_submit_evidence_feedback
# （preview/submit 两段确认；一回答一反馈；not_helpful 进 bad_cases）。
# ── M5-A 工具 C：propose_relation（高风险，独立开关） ──
# AGENT_PROPOSE_RELATION_TOOL_ENABLED=true：暴露 mindgraph_propose_relation
# （preview/submit 两段确认；仅 proposed 绝不自动生效；三端 ACL；双向幂等）。

# ── 数据库 ──
# DATABASE_PATH=data/product/product.sqlite3   (自动生成)
SQLITE_JOURNAL_MODE=WAL
SQLITE_SYNCHRONOUS=NORMAL
SQLITE_CACHE_SIZE=-20000     # 20MB

# ── 缓存 ──
CACHE_ENABLED=true
ANSWER_CACHE_TTL_SECONDS=3600
EMBEDDING_CACHE_SIZE=10000

# ── 数据备份 ──
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
# BACKUP_DIR=data/backups    (自动生成)

# ── 监控 ──
SLOW_REQUEST_THRESHOLD_MS=1000
HEALTH_CHECK_INTERVAL_SECONDS=30
