# ============================================================
# Expense RAG QA — 环境配置模板
# 复制为 .env 并修改: cp .env.example .env
# ⚠️ .env 包含密钥，禁止提交到 Git
# ============================================================

# ── 运行环境 ──
ENVIRONMENT=development       # development | staging | production
DEBUG=false
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console            # console | json (生产用 json)

# ── 服务配置 ──
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000/api/v1
STREAMLIT_ORIGIN=http://localhost:8501
CORS_ORIGINS=http://localhost:8501    # 多个用逗号分隔

# ── 认证模式 ──
# off: 关闭认证
# api_key: 使用 X-API-Key Header 鉴权
# bearer: 使用 Authorization: Bearer 鉴权
# demo: 演示模式（简单本地会话）
AUTH_MODE=demo
SESSION_TIMEOUT_SECONDS=3600

# ── 安全 ──
RATE_LIMIT_ENABLED=false
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
MAX_UPLOAD_BYTES=10485760        # 10MB
PRIVACY_LOG_QUESTIONS=true

# ── LLM Provider — 智谱 AI ──
# 申请地址: https://open.bigmodel.cn/
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4.7
ZHIPU_VERIFIED=false

# ── LLM Provider — DeepSeek (OpenAI Compatible) ──
# 申请地址: https://platform.deepseek.com/
CHAT_PROVIDER=deepseek           # zhipu | deepseek | anthropic
OPENAI_COMPAT_PROVIDER_NAME=deepseek
OPENAI_COMPAT_BASE_URL=https://api.deepseek.com
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=deepseek-v4-flash
OPENAI_COMPAT_MODELS=deepseek-v4-flash    # 逗号分隔允许列表
OPENAI_COMPAT_VERIFIED=false
CHAT_TIMEOUT_SECONDS=60
CHAT_MAX_RETRIES=1

# ── LLM Provider — Anthropic (Claude) ──
# 申请地址: https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── Embedding 模型 ──
BGE_MODEL_NAME=BAAI/bge-small-zh-v1.5
# BGE_MODEL_REVISION=
BGE_BATCH_SIZE=32
BGE_LOCAL_FILES_ONLY=true

# ── 检索参数 ──
RETRIEVAL_CANDIDATE_COUNT=20
RETRIEVAL_FINAL_TOP_K=5
BM25_K1=1.5
BM25_B=0.75
RRF_CONSTANT=60
RERANKER_ENABLED=false
RERANKER_MODEL_NAME=BAAI/bge-reranker-base
RERANKER_LOCAL_FILES_ONLY=true
RERANK_TOP_N=10

# ── 数据库 ──
# DATABASE_PATH=data/product/product.sqlite3   (自动生成)
SQLITE_JOURNAL_MODE=WAL
SQLITE_SYNCHRONOUS=NORMAL
SQLITE_CACHE_SIZE=-20000     # 20MB

# ── 缓存 ──
CACHE_ENABLED=true
ANSWER_CACHE_TTL_SECONDS=3600
EMBEDDING_CACHE_SIZE=10000

# ── 数据备份 ──
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
# BACKUP_DIR=data/backups    (自动生成)

# ── 监控 ──
SLOW_REQUEST_THRESHOLD_MS=1000
HEALTH_CHECK_INTERVAL_SECONDS=30
