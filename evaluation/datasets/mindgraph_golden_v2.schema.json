{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mindgraph_golden_v2.schema.json",
  "title": "MindGraph V2 golden retrieval case",
  "description": "Per-record schema. Cross-record uniqueness and dataset-version consistency are enforced by validate_golden_cases.",
  "type": "object",
  "required": [
    "case_id",
    "question",
    "category",
    "split",
    "expected_behavior",
    "gold_vault_paths",
    "required_facts",
    "forbidden_facts",
    "dataset_version",
    "label_source"
    ,"query_type"
    ,"difficulty"
    ,"expected_route"
    ,"graph_needed"
    ,"acl_context"
    ,"source"
    ,"validation_status"
    ,"notes"
  ],
  "properties": {
    "case_id": {"type": "string", "pattern": "\\S"},
    "question": {"type": "string", "pattern": "\\S"},
    "category": {"type": "string", "pattern": "\\S"},
    "split": {"enum": ["development", "regression"]},
    "expected_behavior": {"enum": ["answer", "abstain"]},
    "gold_vault_paths": {
      "type": "array",
      "items": {"type": "string", "pattern": "\\S"},
      "uniqueItems": true
    },
    "required_facts": {
      "type": "array",
      "items": {"type": "string", "pattern": "\\S"}
    },
    "forbidden_facts": {
      "type": "array",
      "items": {"type": "string", "pattern": "\\S"}
    },
    "dataset_version": {"type": "string", "pattern": "\\S"},
    "label_source": {"type": "string", "pattern": "\\S"},
    "query_type": {"type": "string", "pattern": "\\S"},
    "difficulty": {"enum": ["easy", "medium", "hard"]},
    "expected_route": {"type": "string", "pattern": "\\S"},
    "graph_needed": {"type": "boolean"},
    "acl_context": {"type": "object"},
    "source": {"type": "string", "pattern": "\\S"},
    "validation_status": {"const": "approved"},
    "notes": {"type": "string"},
    "evaluation_date": {"type": "string", "format": "date"},
    "historical_vault_paths": {
      "type": "array",
      "items": {"type": "string", "pattern": "\\S"},
      "uniqueItems": true
    },
    "query_translations": {
      "type": "array",
      "items": {"type": "string", "pattern": "\\S"},
      "minItems": 1
    },
    "expected_relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_path", "target_path", "relation_type"],
        "properties": {
          "source_path": {"type": "string", "pattern": "\\S"},
          "target_path": {"type": "string", "pattern": "\\S"},
          "relation_type": {"type": "string", "pattern": "\\S"}
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"expected_behavior": {"const": "answer"}}},
      "then": {
        "properties": {
          "gold_vault_paths": {"minItems": 1},
          "required_facts": {"minItems": 1}
        }
      }
    },
    {
      "if": {"properties": {"expected_behavior": {"const": "abstain"}}},
      "then": {"properties": {"gold_vault_paths": {"maxItems": 0}}}
    }
  ],
  "additionalProperties": false
}
